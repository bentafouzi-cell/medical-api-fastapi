# Copier ce fichier en .env pour le developpement local.
# Sur Render, ces valeurs se reglent dans l'onglet Environment.
# Le fichier .env est ignore par Git : ne jamais y mettre de vraies cles commitees.

# --- Obligatoires : l'application refuse de demarrer sans elles ---

# Cle de signature des sessions. Aleatoire, jamais ecrite a la main.
# Generer : python -c "import secrets; print(secrets.token_urlsafe(48))"
# Changer cette valeur deconnecte tous les utilisateurs.
SECRET_KEY=

# Local : sqlite:///./medical.db
# Render : postgresql://... (fourni par le service PostgreSQL)
DATABASE_URL=sqlite:///./medical.db

# --- Compte super-admin, cree au demarrage s'il n'existe aucun admin ---
# Changer ces valeurs ne modifie PAS un compte admin deja existant.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Brevo : envoi du lien de reinitialisation de mot de passe ---
BREVO_API_KEY=
SENDER_EMAIL=

# URL publique du site, utilisee dans les liens envoyes par email
BASE_URL=http://127.0.0.1:8000

# --- Reglages de session ---

# Duree de connexion en minutes (720 = 12 h)
SESSION_MINUTES=720

# Cookie securise : true en production (https), false en local (http).
# Laisse a true sur Render, sinon le cookie circule en clair.
COOKIE_SECURE=false
